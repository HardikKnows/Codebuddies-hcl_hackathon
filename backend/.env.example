# Copy to backend/.env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://localhost:5432/retailpulse
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_MINUTES=480
CORS_ORIGINS=http://localhost:5173

# OpenAI. Run `python -m scripts.check_openai` to list the models your key can use,
# then set the exact model IDs below (no defaults are assumed).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
# Optional, reasoning models only: low | medium | high
OPENAI_REASONING_EFFORT=
# Must match the embedding model's output size; it is fixed in the database schema.
EMBEDDING_DIM=1536

RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.30
RAG_HIGH_SIMILARITY=0.50
